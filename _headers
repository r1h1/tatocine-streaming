# Cabeceras para Netlify (se aplican también al arrastrar la carpeta o el ZIP). Vercel: ver vercel.json.
/index.html
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=604800
